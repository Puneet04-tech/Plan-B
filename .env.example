# Environment Variables for Plan B

# Cloudflare Workers AI (optional; without it the app uses curated fallback ideas)
# Create a token in Cloudflare dashboard -> Workers AI -> Use REST API
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here
# Optional: override the model (default @cf/meta/llama-3.1-8b-instruct)
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Origin (for frontend)
# Comma-separated allowlist; wildcard `*` allows any origin (demo mode only).
# For production add your Vercel URL, e.g.:
#   ALLOWED_ORIGIN=https://plan-b.vercel.app,http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# Frontend API URL (for Vercel deployment)
VITE_API_BASE_URL=https://plan-b-ow6r.onrender.com

# Session Secret (for production)
SESSION_SECRET=your-secret-key-here
