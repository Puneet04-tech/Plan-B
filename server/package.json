{
  "name": "plan-b-server",
  "version": "1.0.0",
  "description": "Plan B API — deterministic budget, timeline, vendor and disruption engines plus a Cloudflare Workers AI provider.",
  "main": "dist/server/src/index.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.json src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.0.0",
    "typescript": "^5.5.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8.57.1",
    "nodemon": "^3.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "event-planning",
    "wedding",
    "birthday",
    "community-event",
    "budget",
    "timeline",
    "ai"
  ],
  "files": [
    "src/",
    "dist/"
  ]
}
