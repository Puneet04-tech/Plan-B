{
  "name": "plan-b-server",
  "version": "1.0.0",
  "description": "Plan B Event Planning Assistant - Server",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.json src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "vitest": {
    "include": [
      "tests/**/*.{test,spec}.?(c|m)[jt]s?(x)"
    ]
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonschema": "^1.4.1",
    "typescript": "^5.5.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "nodemon": "^3.0.0",
    "tsx": "^4.0.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "event planning",
    "wedding",
    "birthday",
    "community event",
    "budget",
    "timeline",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src/",
    "dist/"
  ]
}
